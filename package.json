{
  "name": "live-voting",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run clean && npm run typecheck && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --exclude tests/load.test.ts",
    "test:watch": "vitest",
    "test:load": "vitest run tests/load.test.ts --testTimeout=30000"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.11",
    "better-sqlite3": "13.2.0",
    "dotenv": "18.0.10",
    "fastify": "5.12.8",
    "openai": "7.60.0",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "esbuild@0.28.2": true
  }
}
